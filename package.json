{
  "name": "freeroam-journal-capturer",
  "version": "1.0.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freeroam.journalcapturer",
    "productName": "Freeroam Journal Capturer",
    "asar": false,
    "extraResources": [
      {
        "from": "./node_modules/playwright",
        "to": "node_modules/playwright"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
